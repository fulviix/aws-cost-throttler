{
  "name": "aws-cost-throttler",
  "version": "0.1.0",
  "description": "High-performance Redis rate limiter for Express with dynamic AWS budget-aware throttling",
  "keywords": [
    "rate-limiter",
    "throttle",
    "throttling",
    "express",
    "express-middleware",
    "redis",
    "aws",
    "aws-budgets",
    "cost-management",
    "sliding-window"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fulviix/aws-cost-throttler.git"
  },
  "homepage": "https://github.com/fulviix/aws-cost-throttler#readme",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap && cp src/core/sliding-window.lua dist/sliding-window.lua",
    "dev": "tsup src/index.ts --format esm --dts --watch --onSuccess \"cp src/core/sliding-window.lua dist/sliding-window.lua\"",
    "typecheck": "tsc --noEmit",
    "redis:up": "docker compose up -d",
    "redis:down": "docker compose down",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-budgets": "^3.1131.0",
    "ioredis": "^6.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/supertest": "^7.2.1",
    "express": "^5.2.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
