{
  "name": "aws-cost-throttler",
  "version": "0.1.0",
  "description": "High-performance Redis rate limiter for Express with dynamic AWS budget-aware throttling",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "redis:up": "docker compose up -d",
    "redis:down": "docker compose down",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "dependencies": {
    "ioredis": "^6.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "express": "^5.2.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
